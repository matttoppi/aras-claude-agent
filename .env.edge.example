# Innovator Edge sample environment configuration
API_BACKEND=EDGE

# Provide the fully scoped Edge base URL (instance/app included).
API_URL=https://innovatoredge-beta.aras-cloud.com/api/LabsInstance/ProblemReport
# Keep API_BASE_PATH blank unless you need to append an extra segment.
API_BASE_PATH=
EDGE_METHOD_PREFIX=methods

# Authentication
AUTH_MODE=API_KEY
EDGE_API_KEY_HEADER=Authorization
EDGE_API_KEY=<your-edge-api-key>

# Optional tuning
API_TIMEOUT=30
API_RETRY_COUNT=3
API_RETRY_DELAY=1
